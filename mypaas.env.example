# myPaaS environment template
#
# Copy this file outside the repository and keep it mode 0600:
#   install -m 600 mypaas.env.example /etc/mypaas/mypaas.env
#
# Load it with:
#   set -a; . /etc/mypaas/mypaas.env; set +a
#   java -jar target/mypaas-0.0.1-SNAPSHOT.jar
#
# Never commit a filled-in copy. `.env` and `*.env` are gitignored; this
# template is the only environment file intended for the repository.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Set to false in production. Demo mode seeds the known demo account:
#   john@example.com / mypaas-demo!
MYPAAS_DEMO_SEED=true
MYPAAS_PUBLIC_BASE_URL=http://localhost:8080
MYPAAS_MANAGED_NAMESPACE=example.com

# ---------------------------------------------------------------------------
# First-boot administrator (production)
# ---------------------------------------------------------------------------
# Used only when no ADMIN user exists. The account is forced to change its
# password on first sign-in. Remove these after first boot.
# MYPAAS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# MYPAAS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password

# ---------------------------------------------------------------------------
# Keys and storage
# ---------------------------------------------------------------------------
# Keep the key directory outside the repository and back it up separately from
# the database. Losing it makes encrypted secrets unrecoverable.
MYPAAS_KEYS_DIR=./data/keys
MYPAAS_STORAGE_ROOT=./data/storage

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development default: H2 file database. The application also ships the
# PostgreSQL driver; uncomment and set these for production.
# SPRING_DATASOURCE_URL=jdbc:postgresql://db.internal:5432/mypaas
# SPRING_DATASOURCE_USERNAME=mypaas
# SPRING_DATASOURCE_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Mail / notifications
# ---------------------------------------------------------------------------
# capture = no SMTP; OTPs, password-reset and verification emails are written to
# the admin-only dev mailbox at /dashboard/dev-mailbox.
MYPAAS_NOTIFICATIONS_MODE=capture
MYPAAS_MAIL_FROM="myPaaS <no-reply@example.com>"

# Production SMTP example. The "id" is the SMTP username / provider API-key ID.
# MYPAAS_NOTIFICATIONS_MODE=smtp
# SPRING_MAIL_HOST=smtp.example.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=smtp-user-or-api-key-id
# SPRING_MAIL_PASSWORD=replace-me
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# For implicit TLS on port 465 instead of STARTTLS:
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true

# ---------------------------------------------------------------------------
# Optional runtime tuning
# ---------------------------------------------------------------------------
# SERVER_PORT=8080
# MYPAAS_MAX_CONCURRENT_DEPLOYMENTS=3
# MYPAAS_LOG_BUFFER_SIZE=5000
# MYPAAS_JOB_WORKER_THREADS=3
# MYPAAS_JOB_WORKER_ENABLED=true
# MYPAAS_MAX_UPLOAD_BYTES=52428800

# Note: project/server secrets (DATABASE_URL, API tokens, SSH keys, webhook
# secrets) do not belong here. Store them through the credentials API and
# reference the returned credential ID. See docs/secrets.md.
